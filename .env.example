DISCORD_TOKEN=your_discord_bot_token
OWNER_ID=123456789012345678
GUILD_ID=123456789012345678
TIMEZONE=America/New_York

# Optional conversational AI; fixed commands and scheduled summaries need no key.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=
# Optional UTF-8 preferences file inside the runtime filesystem.
AI_SYSTEM_PROMPT_FILE=

# Docker Compose sets the SQLite/backup paths to persistent mounted directories.
# For a local installation, omit DATABASE_PATH and BACKUP_DIR for project defaults.
# DATABASE_PATH=data/ybot.sqlite3
# BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=INFO
